# Guild Manage Suite - FiveM Bridge
# 1) Dashboard -> FiveM -> Opsætning
# 2) Generér/rotér en bridge-nøgle
# 3) Indsæt Discord guild ID + den nye nøgle her
# 4) ensure guild_manage_bridge
# 5) Kør "gmsbridge" i serverkonsollen for diagnostics

setr gms_api_base "https://bot.nethost-solutions.dk"
setr gms_guild_id "DIT_DISCORD_GUILD_ID"
setr gms_api_key "gms_DIN_BRIDGE_NØGLE"
setr gms_server_id "main"
setr gms_framework "auto"

# De fleste skal IKKE ændre disse:
# setr gms_command_poll_ms "1500"
# setr gms_player_sync_ms "15000"
# setr gms_heartbeat_ms "30000"
# setr gms_settings_refresh_ms "60000"
# setr gms_client_action_timeout_ms "8000"
# setr gms_api_timeout_ms "10000"
# setr gms_fail_open "false"
# setr gms_debug "false"

# Valgfri adapters til serverspecifikke scripts:
# setr gms_event_revive "dit_ems:client:revive"
# setr gms_event_jail "dit_jail:client:jail"
# setr gms_event_unjail "dit_jail:client:unjail"
# setr gms_event_clothing "dit_clothing:client:open"

ensure guild_manage_bridge


# Permission mode:
# auto    = detect Nordisk RP ACE hierarchy when present, otherwise use legacy GuildOS permissions
# nrp_ace = force Nordisk RP ACE checks using identifier.discord:<Discord ID>
# legacy  = keep the old GuildOS role-level authorization
set gms_permission_mode "auto"
