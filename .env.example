# Optional manual deployment configuration. Docker Compose supplies local values
# itself; `docker compose up --build` works without copying this file.
# Never put service-role keys or bot secrets in a VITE_* variable.

# === Dashboard: browser-visible configuration ===
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_DISCORD_BOT_CLIENT_ID=1555371176224628787

# === Dashboard: server configuration (also used by bot and Edge Functions) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOT_SECRET_KEY=
# Public URL used in generated links; APP_URL is a backwards-compatible fallback.
PUBLIC_APP_URL=http://localhost:8080
APP_URL=http://localhost:8080

# Discord OAuth remains at the canonical origin described in AGENTS.md.
DISCORD_CLIENT_ID=1555371176224628787
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Optional dashboard integrations. Leave empty to keep them unconfigured.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
HOSTING_API_KEY=
DEPLOY_AGENT_URL=
DEPLOY_AGENT_TOKEN=
GUILDOS_BRIDGE_URL=
GUILDOS_BRIDGE_SECRET=

# === Bot: gateway runtime ===
# start-local.js defaults to offline; opt into real Discord with BOT_OFFLINE=false.
BOT_OFFLINE=true
BOT_HEALTH_PORT=3188
DEFAULT_BOT_TOKEN=
DISCORD_TOKEN=
APPLICATION_ID=1555371176224628787
GUILDOS_DISCOVERY_APPLICATION_ID=1555371176224628787
APP_API_BASE=http://localhost:8080
DEFAULT_BOT_ACTIVITY=GuildOS Bot | /help
BOT_VERSION=
COMMAND_SETTINGS_CACHE_TTL=10000
COMMAND_ANALYTICS_FLUSH_MS=5000
PLATFORM_V3_EVENT_POLL_MS=15000
PLATFORM_V3_HEALTH_SCAN_MS=60000
PLATFORM_V3_SLA_SCAN_MS=60000

# Command deployment: global by default, guild only for test/custom bots.
DEPLOY_SCOPE=global
DEPLOY_GUILD_ID=
# Optional legacy endpoint overrides; normally derived from APP_API_BASE.
API_URL=
INVITE_TRACKER_API_URL=
REACTION_ROLE_API_URL=

# Local bridge and optional deployment agent.
GUILDOS_BRIDGE_HOST=127.0.0.1
GUILDOS_BRIDGE_PORT=3187
BIND_ADDRESS=127.0.0.1
PORT=9000
REPO_DIR=
PM2_NAME=discord-bot

# Bot logging and HTTP retry controls.
LOG_LEVEL=info
LOG_TIMEZONE=Europe/Copenhagen
LOG_HTTP_RETRIES=3
LOG_HTTP_TIMEOUT_MS=15000
# Terminal presentation variables; optional.
NO_COLOR=
TERM=

# Bot music (optional). Compose live profile starts its own Lavalink service.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_NAME=Main
LAVALINK_SECURE=false
LAVALINK_RECONNECT_TRIES=120
LAVALINK_RECONNECT_INTERVAL=30
LAVALINK_REST_TIMEOUT=30
LAVALINK_ERROR_LOG_INTERVAL_MS=300000
LAVALINK_CHECK_TIMEOUT_MS=10000
LAVALINK_JAR=/bot/lavalink/Lavalink.jar
LAVALINK_CONFIG=/bot/lavalink/application.yml
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=

# === Supabase Edge Functions ===
# Configure the server-only variables above in the Edge Function environment:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, BOT_SECRET_KEY,
# DISCORD_BOT_TOKEN, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET,
# DISCORD_PUBLIC_KEY, TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET, HOSTING_API_KEY,
# OPENAI_API_KEY, OPENAI_MODEL, APP_URL, PUBLIC_APP_URL, GUILDOS_BRIDGE_URL,
# GUILDOS_BRIDGE_SECRET, DEPLOY_AGENT_URL and DEPLOY_AGENT_TOKEN.
# VITE_* values are only for the dashboard; never supply VITE_* secret copies.
