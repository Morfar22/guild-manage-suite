{
  "name": "guildos-bot",
  "version": "1.0.0",
  "description": "GuildOS Bot - Discord server management, moderation and automation",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "deploy-commands": "node deployCommands.js",
    "setup": "bash setup.sh",
    "kickbot:scan": "node scripts/kick-bot-everywhere.js 1067179642391363654",
    "kickbot:execute": "node scripts/kick-bot-everywhere.js 1067179642391363654 --execute",
    "lavalink:check": "node scripts/check-lavalink.js",
    "lavalink:install": "bash scripts/install-lavalink.sh",
    "lavalink:start": "bash scripts/start-lavalink.sh",
    "lavalink:pm2": "pm2 start ecosystem.lavalink.config.js",
    "lavalink:restart": "pm2 restart guildos-lavalink --update-env",
    "lavalink:logs": "pm2 logs guildos-lavalink --lines 100"
  },
  "dependencies": {
    "discord.js": "14.26.4",
    "@supabase/supabase-js": "2.107.0",
    "dotenv": "16.6.1"
  },
  "optionalDependencies": {
    "kazagumo": "3.4.3",
    "shoukaku": "4.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "commonjs"
}
