# GuildOS Bot manual deployment. See root .env.example for dashboard/functions.
# `node start-local.js` defaults to offline; `node bot.js` always runs the live bot.
BOT_OFFLINE=true
BOT_HEALTH_PORT=3188

# Discord credentials (never commit populated values).
DEFAULT_BOT_TOKEN=
DISCORD_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=1555371176224628787
APPLICATION_ID=1555371176224628787
GUILDOS_DISCOVERY_APPLICATION_ID=1555371176224628787
DEFAULT_BOT_ACTIVITY=GuildOS Bot | /help
BOT_VERSION=
DEPLOY_SCOPE=global
DEPLOY_GUILD_ID=

# Shared API/database configuration.
APP_API_BASE=http://localhost:8080
BOT_SECRET_KEY=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_URL=
INVITE_TRACKER_API_URL=
REACTION_ROLE_API_URL=
COMMAND_SETTINGS_CACHE_TTL=10000
COMMAND_ANALYTICS_FLUSH_MS=5000
PLATFORM_V3_EVENT_POLL_MS=15000
PLATFORM_V3_HEALTH_SCAN_MS=60000
PLATFORM_V3_SLA_SCAN_MS=60000

# Bridge and deployment agent (optional).
GUILDOS_BRIDGE_HOST=127.0.0.1
GUILDOS_BRIDGE_PORT=3187
GUILDOS_BRIDGE_SECRET=
BIND_ADDRESS=127.0.0.1
PORT=9000
REPO_DIR=
PM2_NAME=discord-bot
DEPLOY_AGENT_TOKEN=
LOG_LEVEL=info
LOG_TIMEZONE=Europe/Copenhagen
LOG_HTTP_RETRIES=3
LOG_HTTP_TIMEOUT_MS=15000
NO_COLOR=
TERM=

# Music / Lavalink (optional).
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_NAME=Main
LAVALINK_SECURE=false
LAVALINK_RECONNECT_TRIES=120
LAVALINK_RECONNECT_INTERVAL=30
LAVALINK_REST_TIMEOUT=30
LAVALINK_ERROR_LOG_INTERVAL_MS=300000
LAVALINK_CHECK_TIMEOUT_MS=10000
LAVALINK_JAR=/bot/lavalink/Lavalink.jar
LAVALINK_CONFIG=/bot/lavalink/application.yml
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=
