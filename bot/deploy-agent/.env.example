# Samme token som DEPLOY_AGENT_TOKEN i Lovable Cloud secrets
DEPLOY_AGENT_TOKEN=skift-mig-til-samme-som-i-lovable

# Port agenten lytter på (nginx proxier til denne)
PORT=9000

# Absolut sti til din bot-mappe på VPS'en (hvor git pull skal køre)
REPO_DIR=/home/discord-bot

# PM2 process-navn (skal matche det du startede bot'en med)
PM2_NAME=discord-bot

# (Valgfri) GitHub webhook secret hvis du senere vil tilføje auto-deploy
GITHUB_WEBHOOK_SECRET=
