{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guild-manage-suite",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "keep_vars": true,
  "secrets": {
    "required": ["OPENAI_API_KEY"],
  },
  // Required by the PR build's `wrangler preview` command. Preview bindings and
  // secrets are configured separately from production in Cloudflare Previews Base.
  "previews": {},
}
